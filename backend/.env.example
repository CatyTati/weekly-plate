# Copy to .env and fill in from Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Only if your project still signs tokens with the legacy JWT secret (HS256).
# Newer projects use signing keys and need nothing here.
SUPABASE_JWT_SECRET=

# 1 = run without Supabase (data in memory, sign in with "Bearer dev:<uuid>")
USE_MEMORY_REPO=0

# Comma-separated, e.g. the Expo web dev server
CORS_ORIGINS=http://localhost:8081
