# Copy to .env and fill in from Supabase: Project Settings > API.
# Leave empty to run in demo mode (accounts saved only on the phone).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in inside the app (shows "Weekly Plate" instead of the Supabase address).
# From Google Cloud > Google Auth Platform > Clients. Needs a development or store build;
# Expo Go always uses the browser. See README > Accounts.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only: the iOS client ID, and its "iOS URL scheme" (the client ID reversed:
# com.googleusercontent.apps.xxxx). Leave empty to use the browser on iPhone.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
