# Copy to .env and fill in from Supabase: Project Settings > API.
# Leave empty to run in demo mode (accounts saved only on the phone).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in with the phone's own account picker (shows "Weekly Plate", not the
# Supabase address): the Web client's ID from Google Cloud > Google Auth Platform > Clients.
# For EAS builds add it on expo.dev > project > Environment variables too. See README.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only; leave empty and the iPhone uses the browser for Google.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
