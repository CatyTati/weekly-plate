{
  "expo": {
    "name": "Weekly Plate",
    "slug": "weekly-plate",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF7F6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.catytati.weeklyplate",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Add photos to your recipes."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.catytati.weeklyplate",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#A3546F"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Add photos to your recipes.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication"
    ],
    "scheme": "weeklyplate",
    "extra": {
      "eas": {
        "projectId": "8bbe0e1b-e706-495f-bdfb-3ea3faa341cc"
      }
    },
    "owner": "weekly-plate"
  }
}
